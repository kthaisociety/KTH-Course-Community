# syntax=docker.io/docker/dockerfile:1

FROM node:20-alpine AS base

# Install dependencies only when needed
FROM base AS deps
# Check https://github.com/nodejs/docker-node/tree/b4117f9333da4138b03a546ec926ef50a31506c3#nodealpine to understand why libc6-compat might be needed.
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy workspace package files (all workspaces must be present for npm ci)
COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/
COPY backend-nest/package.json ./backend-nest/
COPY shared/package.json ./shared/

# Lockfile generated on macOS lacks linux-musl platform native binaries.
# Delete it and do fresh install so npm resolves platform-specific optional
# deps (lightningcss, @tailwindcss/oxide) for the current alpine/musl target.
RUN rm package-lock.json && npm install

# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY --from=deps /app/package-lock.json ./package-lock.json

# Copy source code
COPY frontend/ ./frontend/
COPY shared/ ./shared/

# Build shared types before frontend
RUN npm run build:shared

# Next.js collects completely anonymous telemetry data about general usage.
# Learn more here: https://nextjs.org/telemetry
# Uncomment the following line in case you want to disable telemetry during the build.
ENV NEXT_TELEMETRY_DISABLED=1

# Build-time public env vars (pass via --build-arg in CI/CD for deployed builds).
# These must be explicitly provided so production builds never silently bake localhost values.
ARG NEXT_PUBLIC_BACKEND_DOMAIN
ARG NEXT_PUBLIC_WEBSITE_DOMAIN
# Same target as NEXT_PUBLIC_BACKEND_DOMAIN; used by next.config rewrites for /api/auth -> backend /auth.
ARG BACKEND_DOMAIN=
RUN test -n "$NEXT_PUBLIC_BACKEND_DOMAIN" || (echo "Missing build arg NEXT_PUBLIC_BACKEND_DOMAIN" && exit 1)
RUN test -n "$NEXT_PUBLIC_WEBSITE_DOMAIN" || (echo "Missing build arg NEXT_PUBLIC_WEBSITE_DOMAIN" && exit 1)
RUN test -n "$BACKEND_DOMAIN" || (echo "Missing build arg BACKEND_DOMAIN" && exit 1)
ENV NEXT_PUBLIC_BACKEND_DOMAIN=$NEXT_PUBLIC_BACKEND_DOMAIN
ENV NEXT_PUBLIC_WEBSITE_DOMAIN=$NEXT_PUBLIC_WEBSITE_DOMAIN
ENV BACKEND_DOMAIN=$BACKEND_DOMAIN
WORKDIR /app/frontend
RUN npm run build

# Production image, copy all the files and run next
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
# Uncomment the following line in case you want to disable telemetry during runtime.
# ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy the built application
COPY --from=builder /app/frontend/public ./public

# Automatically leverage output traces to reduce image size
# https://nextjs.org/docs/advanced-features/output-file-tracing
COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/static ./frontend/.next/static

# Copy public assets to the correct location for standalone mode
COPY --from=builder --chown=nextjs:nodejs /app/frontend/public ./frontend/public

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# server.js is created by next build from the standalone output
# https://nextjs.org/docs/pages/api-reference/config/next-config-js/output
CMD ["node", "frontend/server.js"]
