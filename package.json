{
  "name": "kth-course-community",
  "version": "1.0.0",
  "description": "This is a [Next.js](https://nextjs.org) project bootstrapped with [`create-next-app`](https://nextjs.org/docs/app/api-reference/cli/create-next-app).",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "bun run test:web",
    "test:web": "bun run --filter kth-course-community-web test",
    "lint": "biome check --fix",
    "format": "biome format --write",
    "build": "echo 'Run build from /apps/web instead'",
    "build:shared": "bun run --filter @shared/types build",
    "dev": "bun run build:shared && bun run --filter kth-course-community-web dev",
    "dev:web": "bun run build:shared && bun run --filter kth-course-community-web dev",
    "add:web": "bun add --filter=kth-course-community-web",
    "add:web:dev": "bun add -d --filter=kth-course-community-web",
    "rm:web": "bun remove --filter=kth-course-community-web",
    "docker:web:build": "bun run build:shared && bun run --filter kth-course-community-web build",
    "ingest": "bun run --filter kth-course-community-web ingest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tegelstenen/course-compass.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Tegelstenen/course-compass/issues"
  },
  "homepage": "https://github.com/Tegelstenen/course-compass#readme",
  "overrides": {
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "lefthook": "^2.0.0",
    "zod": "^3.23.8"
  },
  "dependencies": {
    "better-auth": "^1.7.2",
    "drizzle-orm": "0.45.2"
  }
}
