# PostgreSQL connection string. This one is the local Postgres from
# docker-compose.yml (README, "Set Up the Database").
DATABASE_URL=postgresql://course_community:course_community@127.0.0.1:5438/course_community

# Containers only: apply the committed migrations before the server starts.
# Leave unset for a database the container must not change.
# MIGRATE_ON_START=true

# Better Auth — this is the public site origin
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # Generate with: openssl rand -base64 32

# Google and GitHub sign-in, and the AI Gateway key: locally, staging's values
# (README, "Set Up Environment Variables"). Staging's clients accept localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Vercel AI Gateway — embeddings for search/ingest
AI_GATEWAY_API_KEY=

# Optional: KOPPS fetch parallelism for `bun run ingest`
KOPPS_CONCURRENCY=5

# Amazon SES — magic-link sign-in email. Leave empty locally: outside production
# the link is printed in the dev server's output instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
SES_SENDER=contact@kthais.com
SES_REPLY_TO=contact@kthais.com