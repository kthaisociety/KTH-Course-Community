# ROOT
# =================================
node_modules/
.bun/
package-lock.json
yarn.lock
pnpm-lock.yaml

# OS
.DS_Store

# TypeScript build artifacts (all packages)
*.tsbuildinfo
*.js.map

# Next.js auto-generated type file
next-env.d.ts

# =================================
# WEB (Next.js)
# =================================

# dependencies
/apps/web/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
/apps/web/out/
/apps/web/build

# testing
/apps/web/coverage
/apps/web/.nyc_output

# logs
/apps/web/npm-debug.log*
/apps/web/yarn-debug.log*
/apps/web/yarn-error.log*
